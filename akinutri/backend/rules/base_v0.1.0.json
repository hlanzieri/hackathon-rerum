  "rules": [
    {
      "id": "MS-01",
      "metric": "ms_kg",
      "label": "Consumo de materia seca",
      "unit": "kg MS/animal/dia",
      "scale_by_intake": true,
      "source": "MVP",
      "basis": "Consumo informado pelo usuario; nao estimado pelo sistema.",
      "if": {
        "fact": "ms_kg",
        "operator": "outside_inclusive_profile_range"
      },
      "then": {
        "status": "violada"
      },
      "else": {
        "status": "atendida"
      }
    },
    {
      "id": "PB-01",
      "metric": "pb_pct",
      "label": "Proteina bruta",
      "unit": "% MS",
      "source": "PSU_PB",
      "basis": "Faixas do perfil sao adaptacoes didaticas; nao substituem proteina metabolizavel.",
      "if": {
        "fact": "pb_pct",
        "operator": "outside_inclusive_profile_range"
      },
      "then": {
        "status": "violada"
      },
      "else": {
        "status": "atendida"
      }
    },
    {
      "id": "FDN-01",
      "metric": "fdn_pct",
      "label": "FDN total",
      "unit": "% MS",
      "source": "NASEM2021",
      "basis": "Minimo 25% depende de TMR, particula adequada e milho seco; demais limites sao hipoteses MVP.",
      "if": {
        "fact": "fdn_pct",
        "operator": "outside_inclusive_profile_range"
      },
      "then": {
        "status": "violada"
      },
      "else": {
        "status": "atendida"
      }
    },
    {
      "id": "FDNV-01",
      "metric": "fdn_volumoso_pct",
      "label": "FDN de volumosos",
      "unit": "% MS da dieta",
      "source": "NASEM2021",
      "basis": "19% no contexto de referencia. Perfil seco e limites adicionais sao hipoteses MVP.",
      "if": {
        "fact": "fdn_volumoso_pct",
        "operator": "outside_inclusive_profile_range"
      },
      "then": {
        "status": "violada"
      },
      "else": {
        "status": "atendida"
      }
    },
    {
      "id": "AMIDO-01",
      "metric": "amido_pct",
      "label": "Amido",
      "unit": "% MS",
      "source": "PSU_AMIDO",
